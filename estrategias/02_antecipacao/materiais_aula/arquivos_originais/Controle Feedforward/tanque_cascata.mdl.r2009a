      MaskToolTipString	      "on,on,on"
      MaskVarAliasString      ",,"
      MaskVariables	      "Fi=@1;Fv=@2;T=@3;"
      MaskInitialization      "\nx = -1:.1:1;\ny1 =  x;\ny2 = -x;\n\nx1 = zeros(1,3);\ny3 = [0 1 7];\n\ny4 = -1:.1:1;\n"
      "r = sqrt(2);\nx2 = sqrt(r^2-y4.^2);\nx3 = -sqrt(r^2-y4.^2);\n\nxs = -sqrt(2)-.5:0.1:sqrt(2)+.5;\nys = sin(10000*"
      "xs)/3-sqrt(2)-.3;\n\ny1t = y1 + 3;\ny2t = y2 + 3;\n\ny4t = 2:.1:4;\nx2t =  sqrt(r^2-(y4t-3).^2);\nx3t = -sqrt(r^"
      "2-(y4t-3).^2);\n\n"
      MaskDisplay	      "\nplot(x,y1,x,y2,x1,y3,x2,y4,x3,y4,xs,ys)\nplot(x,y1t,x,y2t,x2t,y4t,x3t,y4t)\nplot(sqrt(2)+0."
      "5,0,-sqrt(2)-0.5,0)\n\n"

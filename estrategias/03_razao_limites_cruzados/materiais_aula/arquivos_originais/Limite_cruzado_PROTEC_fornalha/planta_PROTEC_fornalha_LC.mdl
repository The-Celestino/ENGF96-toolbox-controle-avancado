	Annotation {
	  SID			  "192"
	  Name			  "            INFORMAÇÕES  PARA  AVALIAÇÃO  ECONÔMICA  DA  PLANTA  PROTEC\n\nPreço de compra de A:         "
	  "          prA =   1 000.xA^8             u.e./t de A\nPreço de venda  de B:                    prB =  10 000.xB^0.5"
	  "         u.e./t de produto, para xB >= 0.755\n                                                       prB =    1 000"
	  ".xB                u.e./t de produto, para xB < 0.755\nPreço de compra do combustível:   prC =   3 000             "
	  "        u.e./t de combustível\nPreço do tratamento do efluente:    prE =   2 000                     u.e./t de eflu"
	  "ente\nPreço de venda  de vapor:              prV =      500.PV^2/18.52  u.e./t de produto \nPreço do catalisador:  "
	  "                 prCat = 10 000/kg de catalisador\nCusto de processamento:                ctP =     500.(Fp)^3     "
	  "     u.e./t de carga processada\nO custo de processamento inclui todos os custos variaveis, exceto os explicitados "
	  "anteriormente\n\nxA - fração molar de A na alimentação\nxB - fração molar de B no produto\nPV - Pressão do Vapor [="
	  "] kgf/cm²\nFp - vazão processada\n\nu.e. - unidade econômica"
	  Position		  [207, 15, 807, 305]
	  InternalMargins	  [0, 0, 0, 0]
	  FixedHeight		  off
	  FixedWidth		  off
	  HorizontalAlignment	  "left"
	  ZOrder		  -2
	  FontSize		  14
	}
